# Steam API Key - https://steamcommunity.com/dev/apikey adresinden alabilirsin
STEAM_API_KEY=your_steam_api_key_here

# FACEIT API Key - https://developers.faceit.com adresinden alabilirsin
FACEIT_API_KEY=your_faceit_api_key_here

# Upstash Redis - rate limiting ve kalıcı cache için (Faz 0/1)
# https://console.upstash.com adresinden REST URL/token alabilirsin
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase - kalıcı veritabanı için (Faz 0/2/5)
# https://supabase.com/dashboard adresinden proje oluşturup alabilirsin
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string (Drizzle migrasyonları/queryleri için)
SUPABASE_DB_URL=

# Sentry - hata/monitoring için (Faz 1)
# https://sentry.io adresinden proje oluşturup DSN alabilirsin
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Opsiyonel - source map upload için (kurulmazsa build yine çalışır, sadece upload atlanır)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Sitenin canlı adresi - OG image/metadata mutlak URL üretimi için (Faz 1)
# Yerelde boş bırakılabilir, Vercel'e deploy ederken production URL'ini gir
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron secret - /api/cron/snapshot route'unu Vercel Cron dışında kimsenin
# tetikleyememesi için rastgele bir string (Faz 2). Örn: openssl rand -hex 32
CRON_SECRET=
